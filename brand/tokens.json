{
  "_comment": "Single source of truth for how slides look. render.py, the linter, and the Claude system prompt all read this file and nothing else. Change a value here and the next drop is on-brand end to end.",

  "brand": {
    "handle": "@yourhandle",
    "site": "yoursite.com"
  },

  "canvas": {
    "width": 1080,
    "height": 1350,
    "scale": 2,
    "margin": 96,
    "format": "jpeg",
    "quality": 92
  },

  "type": {
    "display": "Bricolage Grotesque",
    "body": "Archivo",
    "display_weight": 800,
    "tracking_display": "-0.03em",
    "tracking_label": "0.16em",
    "leading_display": 0.98,
    "leading_body": 1.5
  },

  "scale": {
    "cover_max": 132,
    "cover_min": 76,
    "headline_max": 92,
    "headline_min": 52,
    "stat_max": 300,
    "stat_min": 150,
    "body": 36,
    "body_small": 31,
    "label": 22,
    "footer": 21
  },

  "active_theme": "ink",

  "themes": {
    "ink": {
      "bg": "#111A2B",
      "surface": "#1A2438",
      "ink": "#F5F3EF",
      "ink_soft": "#93A0B5",
      "accent": "#FF5A3C",
      "rule": "#2A3752"
    },
    "paper": {
      "bg": "#F5F3EF",
      "surface": "#EAE7E0",
      "ink": "#111A2B",
      "ink_soft": "#5E6A7D",
      "accent": "#D8401F",
      "rule": "#D8D4CB"
    }
  }
}
